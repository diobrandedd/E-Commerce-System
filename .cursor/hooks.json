{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/verify_on_stop.ps1",
        "loop_limit": 5
      }
    ],
    "subagentStop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/verify_on_subagent_stop.ps1",
        "matcher": "shell|verifier",
        "loop_limit": 5
      }
    ]
  }
}
